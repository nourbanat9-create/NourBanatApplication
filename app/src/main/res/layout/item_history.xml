<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardHistoryItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Book Cover Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivBookCover"
            android:layout_width="64dp"
            android:layout_height="88dp"
            android:background="@color/primary_light"
            android:contentDescription="@string/book_cover"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_book"
            app:cornerSize="6dp"
            app:tint="@color/primary" />

        <!-- Book Details Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- Book Title -->
            <TextView
                android:id="@+id/tvBookTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="The Great Gatsby" />

            <!-- Other User Name -->
            <TextView
                android:id="@+id/tvOtherUserName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="With: Sarah Ahmed" />

            <!-- Transaction Type -->
            <TextView
                android:id="@+id/tvTransactionType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Exchange 🔄" />

            <!-- Date -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_hint"
                android:textSize="12sp"
                tools:text="12 Nov 2026" />

        </LinearLayout>

        <!-- Status Tag -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_logo_circle"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Completed" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
<!-- تصميم العنصر الواحد (item_history.xml):

ليش عمله؟ هاد شكل "الكرت الواحد" اللي رح يتكرر في القائمة (وين تنحط صورة الكتاب، وين ينكتب الاسم، ووين التاريخ).
 بدل ما نصمم 100 كرت بإيدنا، بنصمم واحد بس وبنخليه يتكرر.-->
